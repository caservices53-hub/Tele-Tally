# Tally
TALLY_URL=http://localhost:9000
TALLY_COMPANY=

# Local database / safety
GPT_TALLY_DB=./data/gpt_tally_v2.sqlite3
GPT_TALLY_AUTO_THRESHOLD=0.90
GPT_TALLY_BATCH_SIZE=100
GPT_TALLY_DEFAULT_BANK_LEDGER=

# Optional OpenAI classification for unresolved rows.
# The engine works without these; unknown rows simply remain in the review queue.
OPENAI_API_KEY=
OPENAI_MODEL=
GPT_TALLY_AI_AUTO_APPROVE=0

# Optional remote MCP mode
TALLY_MCP_TRANSPORT=stdio
TALLY_MCP_HOST=127.0.0.1
TALLY_MCP_PORT=8000
TALLY_MCP_TOKEN=
